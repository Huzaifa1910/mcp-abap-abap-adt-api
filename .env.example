# SAP Connection Settings (Source system)
SAP_URL=https://example.sap-server.com:44300
SAP_USER=EXAMPLE_USER
SAP_PASSWORD=your_password_here
SAP_CLIENT=100
SAP_LANGUAGE=EN

# Optional: Target SAP system for migration tools (MigrationHandlers)
# When set, exposes a second ADT client used by tools like exportObjectBundle / importObjectBundle / compareObjectSource.
TARGET_SAP_URL=https://target.sap-server.com:44300
TARGET_SAP_USER=TARGET_USER
TARGET_SAP_PASSWORD=target_password_here
TARGET_SAP_CLIENT=200
TARGET_SAP_LANGUAGE=EN
